@charset "utf-8";

body { }

.ui_lock_scroll { }

.ui_lock_scroll body { overflow: hidden; }

.ui_content, .ui_title, .ui_buttons input { font: 12px / 1.333 tahoma, aria=
l, =E5=AE=8B=E4=BD=93, sans-serif; }

table.ui_border, table.ui_dialog { width: auto; border-spacing: 0px; }

.ui_border td, .ui_dialog td { padding: 0px; }

.ui_dialog { background: rgb(255, 255, 255); }

.ui_title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap;=
 display: block; cursor: move; background: rgb(221, 221, 221); user-select:=
 none; padding: 0px 100px 0px 0px; }

.ui_title_buttons { position: absolute; cursor: pointer; font-size: 0px; le=
tter-spacing: -0.5em; }

.ui_main { min-width: 6em; text-align: center; }

.ui_content { overflow: hidden; zoom: 1; text-align: left; }

.ui_content.ui_state_full { display: block; width: 100%; height: inherit; m=
argin: 0px; padding: 0px !important; }

.ui_content.ui_state_full { }

.ui_content.ui_state_full iframe { border-radius: 0px 0px 5px 5px; }

.ui_loading { width: 96px; height: 32px; text-align: left; text-indent: -99=
99em; overflow: hidden; background: url("icons/loading.gif") center center =
no-repeat; }

.ui_icon_bg { margin: 20px 0px 20px 15px; }

.ui_min, .ui_max, .ui_close, .ui_res { position: relative; text-decoration:=
 none; letter-spacing: normal; text-align: center; display: inline-block; z=
oom: 1; vertical-align: top; font-family: tahoma, arial, =E5=AE=8B=E4=BD=93=
, sans-serif; }

.ui_min b, .ui_max b, .ui_res_t, .ui_res_b { display: block; position: abso=
lute; overflow: hidden; cursor: pointer; }

.ui_close { font-weight: 500; text-decoration: none; outline: none 0px; }

.ui_close:hover { text-decoration: none; }

.ui_state_tips .ui_main { min-width: 3em; }

.ui_state_tips .ui_content { margin-top: -2px; padding: 8px 10px !important=
; }

.ui_state_tips .ui_icon_bg { margin: 5px 0px 6px 9px; }

.ui_state_tips .ui_title, .ui_state_tips .ui_title_buttons, .ui_res { displ=
ay: none; }

#ldg_lockmask { background: rgb(220, 226, 241); opacity: 0.6; }

.ui_inner { background: rgb(255, 255, 255); margin-left: -4px; margin-right=
: -4px; }

.ui_title_bar { width: 100%; height: 100%; position: relative; border-botto=
m: 0px solid rgb(218, 222, 229); margin-top: -4px; }

.ui_title { display: block; height: 26px; line-height: 26px; border-bottom:=
 1px solid rgb(218, 222, 229); font-size: 14px; font-weight: bold; color: r=
gb(136, 136, 136); background-color: rgb(246, 246, 246); padding-left: 3px;=
 }

.ui_state_focus .ui_title { color: rgb(80, 80, 80); }

.ui_lt, .ui_rt, .ui_lb, .ui_rb, .ui_t, .ui_b { background-image: url("idial=
og/idialog_s.png"); background-repeat: no-repeat; }

.ui_lt { width: 15px; height: 15px; background-position: 0px 0px; }

.ui_rt { width: 15px; height: 15px; background-position: -15px 0px; }

.ui_lb { width: 15px; height: 15px; background-position: 0px -15px; }

.ui_rb { width: 15px; height: 15px; background-position: -15px -15px; }

.ui_t, .ui_b { background-repeat: repeat-x; }

.ui_t { background-position: 0px -30px; }

.ui_b { background-position: 0px -45px; }

.ui_l, .ui_r { background-image: url("idialog/idialog_s2.png"); background-=
repeat: repeat-y; }

.ui_l { background-position: left top; }

.ui_r { background-position: right bottom; }

.ui_title_buttons { top: 0px; right: 5px; }

.ui_max, .ui_res { margin-right: 0px; }

.ui_min, .ui_max, .ui_close, .ui_res { color: rgb(136, 136, 136); font-size=
: 20px; width: 22px; height: 22px; line-height: 18px; }

.ui_min { margin-left: 0px; }

.ui_min_b { top: 10px; left: 5px; width: 12px; height: 2px; border-bottom: =
2px solid rgb(136, 136, 136); }

.ui_max_b { top: 5px; left: 5px; width: 10px; height: 7px; }

.ui_res_t, .ui_res_b { top: 8px; left: 3px; width: 10px; height: 5px; }

.ui_res_b { top: 4px; left: 6px; }

.ui_res_t, .ui_res_b, .ui_max_b { border-width: 3px 1px 1px; border-style: =
solid; border-color: rgb(136, 136, 136); border-image: initial; }

.ui_res_t { background: rgb(255, 255, 255); }

.ui_min:hover b, .ui_max:hover b, .ui_res:hover b, .ui_rese:hover b { borde=
r-color: rgb(36, 146, 255); }

.ui_close { vertical-align: baseline; margin-left: 0px; }

.ui_close:hover, .ui_close:focus { color: rgb(36, 146, 255); }

@media screen and (min-width: 0) {
  .ui_lt, .ui_rt, .ui_lb, .ui_rb { width: 5px; height: 5px; }
  .ui_lt, .ui_t, .ui_rt, .ui_l, .ui_r, .ui_lb, .ui_b, .ui_rb { background: =
none; }
  .ui_lb, .ui_b, .ui_rb { background: url("idialog/idialog_s.png") 0px -45p=
x repeat-x; }
  .ui_lb { border-radius: 0px 0px 0px 5px; }
  .ui_rb { border-radius: 0px 0px 5px; }
  .ui_border { background: rgb(255, 255, 255); border: 1px solid rgb(146, 1=
46, 146); border-radius: 5px; box-shadow: rgba(0, 0, 0, 0.3) 0px 1px 6px; t=
ransition: -webkit-box-shadow 0.2s linear 0s; }
  .ui_state_drag .ui_border, .ui_state_drag.ui_state_lock .ui_border { box-=
shadow: none; }
  .ui_state_lock .ui_border { box-shadow: rgba(0, 0, 0, 0.6) 0px 3px 18px; =
}
  .ui_state_tips:active { border-radius: 5px; box-shadow: rgba(0, 0, 0, 0.5=
) 0px 1px 8px; }
}

.ui_buttons { white-space: nowrap; padding: 4px 8px; text-align: right; bor=
der-top: 1px solid rgb(218, 222, 229); background-color: rgb(246, 246, 246)=
; }

.ui_buttons input { padding: 2px 10px 2px 12px; margin-left: 6px; cursor: p=
ointer; display: inline-block; text-align: center; line-height: 1; height: =
23px; letter-spacing: 3px; overflow: visible; color: rgb(51, 51, 51); borde=
r: 1px solid rgb(153, 153, 153); border-radius: 3px; background: -webkit-gr=
adient(linear, 0% 0%, 0% 100%, from(rgb(250, 250, 250)), to(rgb(228, 228, 2=
28))); text-shadow: rgb(255, 255, 255) 0px 1px 1px; box-shadow: rgba(255, 2=
55, 255, 0.7) 0px 1px 0px, rgba(0, 0, 0, 0.09) 0px -1px 0px; transition: bo=
x-shadow 0.2s linear 0s; }

.ui_buttons input:focus { outline: none 0px; box-shadow: rgb(14, 120, 201) =
0px 0px 3px; }

.ui_buttons input:hover { color: rgb(0, 0, 0); border-color: rgb(102, 102, =
102); box-shadow: none; }

.ui_buttons input:active { border-color: rgb(102, 102, 102); background: -w=
ebkit-gradient(linear, 0% 0%, 0% 100%, from(rgb(250, 250, 250)), to(rgb(228=
, 228, 228))); }

.ui_buttons input[disabled] { cursor: default; color: rgb(102, 102, 102); b=
ackground: rgb(221, 221, 221); border: 1px solid rgb(153, 153, 153); opacit=
y: 0.5; box-shadow: none; }

input.ui_state_highlight { color: rgb(255, 255, 255); border: 1px solid rgb=
(28, 106, 158); text-shadow: rgb(28, 106, 158) 0px -1px 1px; background: -w=
ebkit-gradient(linear, 0% 0%, 0% 100%, from(rgb(51, 187, 238)), to(rgb(34, =
136, 204))); }

input.ui_state_highlight:hover { color: rgb(255, 255, 255); border-color: r=
gb(85, 85, 85); }

input.ui_state_highlight:active { border-color: rgb(28, 106, 158); backgrou=
nd: -webkit-gradient(linear, 0% 0%, 0% 100%, from(rgb(51, 187, 238)), to(rg=
b(34, 136, 204))); }

.ui_content { }

.ui_state_tips .ui_content { text-align: center; font-weight: bold; color: =
rgb(50, 50, 50); width: auto; }

.ui_content div { overflow-wrap: break-word; word-break: break-all; }
